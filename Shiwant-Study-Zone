<script>

/* =========================
NAVIGATION
========================= */

function showSection(id,button){

    document.querySelectorAll(".section")
    .forEach(section=>{
        section.classList.remove("active");
    });

    document.getElementById(id)
    .classList.add("active");

    document.querySelectorAll(".nav button")
    .forEach(btn=>{
        btn.classList.remove("active");
    });

    button.classList.add("active");

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });
}


/* =========================
DATE
========================= */

function updateDate(){

    const now=new Date();

    document.getElementById("dateText")
    .textContent=
    now.toLocaleDateString("hi-IN",{
        weekday:"long",
        year:"numeric",
        month:"long",
        day:"numeric"
    });

}

updateDate();


/* =========================
DARK MODE
========================= */

function toggleDark(){

    document.body.classList.toggle("dark");

    localStorage.setItem(
        "darkMode",
        document.body.classList.contains("dark")
    );

}

if(localStorage.getItem("darkMode")==="true"){
    document.body.classList.add("dark");
}


/* =========================
TASK SYSTEM
========================= */

let tasks=
JSON.parse(localStorage.getItem("studyTasks"))||[];

function addTask(){

    const input=
    document.getElementById("taskInput");

    const text=input.value.trim();

    if(!text){
        alert("पहले task लिखो 🙂");
        return;
    }

    tasks.push({
        text:text,
        done:false
    });

    input.value="";

    saveTasks();
    renderTasks();

}

function renderTasks(){

    const list=
    document.getElementById("taskList");

    list.innerHTML="";

    tasks.forEach((task,index)=>{

        const div=
        document.createElement("div");

        div.className=
        "task "+(task.done?"done":"");

        div.innerHTML=`

        <input type="checkbox"
        ${task.done?"checked":""}
        onchange="toggleTask(${index})">

        <span>${escapeHTML(task.text)}</span>

        <button class="btn red"
        onclick="deleteTask(${index})">
        ✕
        </button>

        `;

        list.appendChild(div);

    });

    updateStats();

}

function escapeHTML(text){

    const div=
    document.createElement("div");

    div.textContent=text;

    return div.innerHTML;
}

function toggleTask(index){

    tasks[index].done=
    !tasks[index].done;

    saveTasks();
    renderTasks();

}

function deleteTask(index){

    tasks.splice(index,1);

    saveTasks();
    renderTasks();

}

function saveTasks(){

    localStorage.setItem(
        "studyTasks",
        JSON.stringify(tasks)
    );

}


/* =========================
STUDY MINUTES
========================= */

let studyMinutes=
Number(localStorage.getItem("studyMinutes"))||0;


/* =========================
TIMER
========================= */

let timeLeft=1500;
let timer=null;

function updateTimer(){

    const min=
    Math.floor(timeLeft/60)
    .toString()
    .padStart(2,"0");

    const sec=
    (timeLeft%60)
    .toString()
    .padStart(2,"0");

    document.getElementById("timerDisplay")
    .textContent=min+":"+sec;

}

function startTimer(){

    if(timer)return;

    document.getElementById("timerMode")
    .textContent=
    "🔥 Focus Mode — Keep studying!";

    timer=setInterval(()=>{

        if(timeLeft>0){

            timeLeft--;

            updateTimer();

        }else{

            clearInterval(timer);

            timer=null;

            studyMinutes+=25;

            localStorage.setItem(
                "studyMinutes",
                studyMinutes
            );

            updateStats();

            alert(
                "🎉 25 minute study session completed!"
            );

            timeLeft=1500;

            updateTimer();

        }

    },1000);

}

function pauseTimer(){

    clearInterval(timer);

    timer=null;

    document.getElementById("timerMode")
    .textContent="⏸ Timer Paused";

}

function resetTimer(){

    clearInterval(timer);

    timer=null;

    timeLeft=1500;

    updateTimer();

    document.getElementById("timerMode")
    .textContent=
    "25 Minute Focus Session";

}

updateTimer();


/* =========================
CHAPTER TRACKER
========================= */

const chapterChecks=
document.querySelectorAll(".chapterCheck");

chapterChecks.forEach((check,index)=>{

    check.checked=
    localStorage.getItem(
        "chapter_"+index
    )==="true";

    check.addEventListener(
        "change",
        function(){

            localStorage.setItem(
                "chapter_"+index,
                check.checked
            );

            updateStats();

        }
    );

});


function updateChapterProgress(){

    let completed=0;

    chapterChecks.forEach(check=>{

        if(check.checked)
        completed++;

    });

    return Math.round(
        completed/chapterChecks.length*100
    );

}


/* =========================
SUBJECT PROGRESS
========================= */

function updateSubjectProgress(
    selector,
    valueId,
    barId
){

    const checks=
    document.querySelectorAll(selector);

    let done=0;

    checks.forEach(c=>{
        if(c.checked)done++;
    });

    const percent=
    Math.round(done/checks.length*100);

    document.getElementById(valueId)
    .textContent=percent+"%";

    document.getElementById(barId)
    .style.width=percent+"%";

}


/* =========================
MAIN STATS
========================= */

function updateStats(){

    document.getElementById("totalMinutes")
    .textContent=studyMinutes;

    const done=
    tasks.filter(t=>t.done).length;

    document.getElementById("doneTasks")
    .textContent=done;

    const taskPercent=
    tasks.length?
    Math.round(done/tasks.length*100):0;

    document.getElementById("taskPercent")
    .textContent=taskPercent+"%";

    const chapterPercent=
    updateChapterProgress();

    document.getElementById("chapterPercent")
    .textContent=
    chapterPercent+"%";

    document.getElementById("overallBar")
    .style.width=
    chapterPercent+"%";

    document.getElementById("overallText")
    .textContent=
    "Chapter completion: "+
    chapterPercent+"%";

    updateSubjectProgress(
        ".physicsCheck",
        "physicsP",
        "physicsBar"
    );

    updateSubjectProgress(
        ".chemistryCheck",
        "chemistryP",
        "chemistryBar"
    );

    updateSubjectProgress(
        ".mathCheck",
        "mathP",
        "mathBar"
    );

}


/* =========================
CHAPTER SEARCH
========================= */

function searchChapters(){

    const search=
    document.getElementById(
        "chapterSearch"
    ).value.toLowerCase();

    document.querySelectorAll(".chapter")
    .forEach(chapter=>{

        const text=
        chapter.innerText.toLowerCase();

        chapter.style.display=
        text.includes(search)
        ?"flex":"none";

    });

}


/* =========================
NOTES
========================= */

const notes=
document.getElementById("notes");

notes.value=
localStorage.getItem("studyNotes")||"";

function saveNotes(){

    localStorage.setItem(
        "studyNotes",
        notes.value
    );

    alert("📝 Notes saved!");

}

function clearNotes(){

    if(confirm("Notes clear करें?")){

        notes.value="";

        localStorage.removeItem(
            "studyNotes"
        );

    }

}


/* =========================
WEEKLY PLANNER
========================= */

const days=[
"mon","tue","wed","thu",
"fri","sat","sun"
];

days.forEach(day=>{

    document.getElementById(day).value=
    localStorage.getItem(
        "plan_"+day
    )||"";

});

function savePlanner(){

    days.forEach(day=>{

        localStorage.setItem(
            "plan_"+day,
            document.getElementById(day).value
        );

    });

    alert("📅 Weekly planner saved!");

}


/* =========================
MARKS
========================= */

function calculateMarks(){

    const ids=[
        "physicsMarks",
        "chemistryMarks",
        "mathMarks",
        "hindiMarks",
        "englishMarks"
    ];

    let total=0;

    ids.forEach(id=>{

        total+=
        Number(
            document.getElementById(id).value
        )||0;

    });

    const percentage=
    total/500*100;

    document.getElementById(
        "marksResult"
    ).textContent=
    "Total: "+total+
    " / 500  |  Percentage: "+
    percentage.toFixed(2)+"%";

    ids.forEach(id=>{

        localStorage.setItem(
            id,
            document.getElementById(id).value
        );

    });

}

[
"physicsMarks",
"chemistryMarks",
"mathMarks",
"hindiMarks",
"englishMarks"
].forEach(id=>{

    document.getElementById(id).value=
    localStorage.getItem(id)||"";

});


/* =========================
QUIZ
========================= */

const quiz=[

{
q:"Newton's second law का formula क्या है?",
options:["F = ma","P = mv","W = Fs","V = IR"],
answer:0
},

{
q:"1 mole में लगभग कितने particles होते हैं?",
options:[
"6.022 × 10²³",
"9.8 × 10²",
"3 × 10⁸",
"1.6 × 10⁻¹⁹"
],
answer:0
},

{
q:"sin²θ + cos²θ = ?",
options:["0","1","2","θ"],
answer:1
},

{
q:"Velocity की SI unit क्या है?",
options:["m","m/s","m/s²","N"],
answer:1
},

{
q:"Force की SI unit क्या है?",
options:["Joule","Watt","Newton","Pascal"],
answer:2
},

{
q:"Water का chemical formula क्या है?",
options:["CO₂","H₂O","O₂","NaCl"],
answer:1
}

];

let quizIndex=0;
let score=0;

function loadQuestion(){

    const q=quiz[quizIndex];

    document.getElementById(
        "question"
    ).textContent=
    (quizIndex+1)+". "+q.q;

    const options=
    document.getElementById("options");

    options.innerHTML="";

    q.options.forEach((option,index)=>{

        const button=
        document.createElement("button");

        button.className="option";

        button.textContent=option;

        button.onclick=()=>{
            checkAnswer(button,index);
        };

        options.appendChild(button);

    });

    document.getElementById(
        "quizScore"
    ).textContent=
    "Score: "+score;

}

function checkAnswer(button,index){

    const q=quiz[quizIndex];

    document.querySelectorAll(".option")
    .forEach(b=>b.disabled=true);

    if(index===q.answer){

        button.classList.add("correct");

        score++;

    }else{

        button.classList.add("wrong");

        document.querySelectorAll(".option")
        [q.answer]
        .classList.add("correct");

    }

    document.getElementById(
        "quizScore"
    ).textContent=
    "Score: "+score;

}

function nextQuestion(){

    quizIndex++;

    if(quizIndex>=quiz.length){

        alert(
            "🎉 Quiz completed!\nYour score: "+
            score+"/"+quiz.length
        );

        quizIndex=0;
        score=0;

    }

    loadQuestion();

}

loadQuestion();


/* =========================
MOTIVATION
========================= */

const quotes=[

"आज की मेहनत कल की ताकत बनेगी.",

"Discipline beats motivation.",

"एक chapter रोज़, धीरे-धीरे पूरा syllabus.",

"गलतियाँ failure नहीं, learning हैं.",

"Focus on progress, not perfection.",

"आज पढ़ो ताकि कल regret न हो.",

"Consistency ही असली superpower है.",

"JEE preparation एक marathon है, sprint नहीं."

];

function newQuote(){

    const index=
    Math.floor(
        Math.random()*quotes.length
    );

    document.getElementById("quote")
    .textContent=
    '"'+quotes[index]+'"';

}


/* =========================
CALCULATOR
========================= */

let expression="";

function press(value){

    expression+=value;

    document.getElementById(
        "calcDisplay"
    ).value=expression;

}

function clearCalc(){

    expression="";

    document.getElementById(
        "calcDisplay"
    ).value="";

}

function backspace(){

    expression=
    expression.slice(0,-1);

    document.getElementById(
        "calcDisplay"
    ).value=expression;

}

function calculate(){

    try{

        const result=
        Function(
            '"use strict";return ('+
            expression+
            ')'
        )();

        expression=
        String(result);

        document.getElementById(
            "calcDisplay"
        ).value=expression;

    }catch{

        document.getElementById(
            "calcDisplay"
        ).value="Error";

        expression="";

    }

}


/* =========================
RESET
========================= */

function resetAll(){

    if(
        confirm(
        "⚠️ पूरा dashboard reset करना है?"
        )
    ){

        localStorage.clear();

        location.reload();

    }

}


/* =========================
INITIALIZE
========================= */

renderTasks();
updateStats();

</script>

