<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
    font-family:Arial, sans-serif;
}

:root{
    --bg:#f4f7ff;
    --card:#ffffff;
    --text:#182033;
    --muted:#697386;
    --primary:#635bff;
    --secondary:#8b5cf6;
    --border:#e5e7eb;
    --green:#16a34a;
    --red:#ef4444;
    --yellow:#f59e0b;
    --shadow:0 12px 35px rgba(0,0,0,.08);
}

body.dark{
    --bg:#080d1c;
    --card:#121a2d;
    --text:#f4f7ff;
    --muted:#aab3c7;
    --border:#29344d;
    --shadow:0 12px 35px rgba(0,0,0,.25);
}

body{
    background:var(--bg);
    color:var(--text);
    transition:.3s;
}

/* HEADER */

header{
    background:linear-gradient(135deg,#5f5cff,#8b5cf6,#ec4899);
    color:white;
    padding:28px 5%;
    box-shadow:0 10px 30px rgba(99,91,255,.25);
}

.header{
    max-width:1250px;
    margin:auto;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
}

.logo h1{
    font-size:28px;
}

.logo p{
    margin-top:7px;
    opacity:.9;
}

.header-buttons{
    display:flex;
    gap:8px;
}

.header-buttons button{
    padding:10px 14px;
    border:1px solid rgba(255,255,255,.3);
    background:rgba(255,255,255,.15);
    color:white;
    border-radius:12px;
    cursor:pointer;
}

/* CONTAINER */

.container{
    width:94%;
    max-width:1250px;
    margin:25px auto 60px;
}

/* WELCOME */

.welcome{
    padding:25px;
    background:var(--card);
    border-radius:22px;
    box-shadow:var(--shadow);
    margin-bottom:22px;
}

.welcome h2{
    font-size:27px;
    margin-bottom:8px;
}

.welcome span{
    color:var(--primary);
}

/* NAV */

.nav{
    display:flex;
    gap:8px;
    overflow-x:auto;
    margin-bottom:22px;
    padding-bottom:4px;
}

.nav button{
    white-space:nowrap;
    padding:11px 15px;
    border:1px solid var(--border);
    background:var(--card);
    color:var(--text);
    border-radius:12px;
    cursor:pointer;
}

.nav button.active{
    background:var(--primary);
    color:white;
}

/* SECTIONS */

.section{
    display:none;
}

.section.active{
    display:block;
    animation:fade .4s ease;
}

@keyframes fade{
    from{
        opacity:0;
        transform:translateY(8px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

/* CARDS */

.grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:20px;
}

.card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:22px;
    padding:22px;
    box-shadow:var(--shadow);
}

.full{
    grid-column:1/-1;
}

.card h2{
    margin-bottom:16px;
}

/* STATS */

.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
    margin-bottom:22px;
}

.stat{
    background:var(--card);
    padding:20px;
    border-radius:18px;
    box-shadow:var(--shadow);
}

.stat .icon{
    font-size:27px;
}

.stat h3{
    font-size:25px;
    margin-top:10px;
}

.stat p{
    color:var(--muted);
    margin-top:5px;
}

/* PROGRESS */

.progress{
    height:11px;
    background:var(--border);
    border-radius:20px;
    overflow:hidden;
}

.progress-bar{
    height:100%;
    width:0;
    background:linear-gradient(90deg,var(--primary),var(--secondary));
    transition:.5s;
}

.subject{
    margin:16px 0;
}

.subject-top{
    display:flex;
    justify-content:space-between;
    margin-bottom:7px;
}

/* BUTTON */

.btn{
    background:var(--primary);
    color:white;
    border:none;
    border-radius:11px;
    padding:11px 16px;
    cursor:pointer;
    font-weight:bold;
}

.btn.red{
    background:var(--red);
}

.btn.green{
    background:var(--green);
}

.btn.gray{
    background:var(--bg);
    color:var(--text);
    border:1px solid var(--border);
}

/* TASKS */

.task-input{
    display:flex;
    gap:8px;
    margin-bottom:15px;
}

input,textarea,select{
    background:var(--bg);
    color:var(--text);
    border:1px solid var(--border);
    border-radius:11px;
    padding:12px;
    outline:none;
}

.task-input input{
    flex:1;
}

.task{
    display:flex;
    align-items:center;
    gap:10px;
    background:var(--bg);
    padding:12px;
    border-radius:12px;
    margin:8px 0;
}

.task span{
    flex:1;
}

.task.done span{
    text-decoration:line-through;
    opacity:.45;
}

/* TIMER */

.timer{
    text-align:center;
}

.timer-display{
    font-size:65px;
    font-weight:bold;
    margin:15px 0;
}

.timer-buttons{
    display:flex;
    justify-content:center;
    gap:8px;
    flex-wrap:wrap;
}

/* NOTES */

textarea{
    width:100%;
    min-height:240px;
    resize:vertical;
}

/* FORMULA */

.formula{
    background:var(--bg);
    border:1px solid var(--border);
    padding:16px;
    border-radius:15px;
    margin:10px 0;
}

.formula h3{
    margin-bottom:7px;
}

.formula code{
    color:var(--primary);
    font-size:18px;
    font-weight:bold;
}

/* CHAPTER */

.chapter{
    display:flex;
    align-items:center;
    gap:10px;
    padding:13px;
    background:var(--bg);
    border-radius:12px;
    margin:8px 0;
}

.chapter span{
    flex:1;
}

.subject-title{
    margin-top:20px;
    margin-bottom:10px;
}

/* QUIZ */

.quiz-question{
    font-size:20px;
    font-weight:bold;
    margin-bottom:15px;
    line-height:1.5;
}

.option{
    width:100%;
    text-align:left;
    padding:13px;
    margin:6px 0;
    border:1px solid var(--border);
    background:var(--bg);
    color:var(--text);
    border-radius:11px;
    cursor:pointer;
}

.option:hover{
    border-color:var(--primary);
}

.option.correct{
    background:#dcfce7;
    color:#166534;
}

.option.wrong{
    background:#fee2e2;
    color:#991b1b;
}

/* MARKS */

.marks-table{
    width:100%;
    border-collapse:collapse;
}

.marks-table th,
.marks-table td{
    padding:12px;
    border-bottom:1px solid var(--border);
    text-align:left;
}

.marks-table input{
    width:100px;
}

/* PLANNER */

.plan{
    display:grid;
    grid-template-columns:repeat(7,1fr);
    gap:8px;
}

.day{
    background:var(--bg);
    border:1px solid var(--border);
    padding:12px;
    border-radius:12px;
    text-align:center;
}

.day textarea{
    min-height:100px;
    margin-top:8px;
    font-size:12px;
}

/* CALCULATOR */

.calc{
    max-width:360px;
    margin:auto;
}

.calc-display{
    width:100%;
    height:60px;
    text-align:right;
    font-size:24px;
    margin-bottom:8px;
}

.calc-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:7px;
}

.calc-grid button{
    height:55px;
    border:1px solid var(--border);
    background:var(--bg);
    color:var(--text);
    border-radius:10px;
    font-size:18px;
    cursor:pointer;
}

.calc-grid button:hover{
    background:var(--primary);
    color:white;
}

/* SEARCH */

.search{
    width:100%;
    margin-bottom:15px;
}

/* QUOTE */

.quote{
    text-align:center;
    padding:20px;
}

.quote-text{
    font-size:20px;
    line-height:1.6;
    font-style:italic;
}

/* FOOTER */

footer{
    text-align:center;
    padding:30px;
    color:var(--muted);
}

/* MOBILE */

@media(max-width:900px){

    .stats{
        grid-template-columns:repeat(2,1fr);
    }

    .grid{
        grid-template-columns:1fr;
    }

    .full{
        grid-column:auto;
    }

    .plan{
        grid-template-columns:1fr 1fr;
    }

    .header{
        flex-direction:column;
        align-items:flex-start;
    }
}

@media(max-width:550px){

    .logo h1{
        font-size:21px;
    }

    .stats{
        gap:8px;
    }

    .stat{
        padding:14px;
    }

    .stat h3{
        font-size:21px;
    }

    .timer-display{
        font-size:48px;
    }

    .plan{
        grid-template-columns:1fr;
    }
}
</style>
</head>

